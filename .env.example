# Final public origin; restart/rebuild after changing. No trailing path.
NEXT_PUBLIC_SITE_URL=https://versal-lestnicy.by
# Keep false until public launch. Blocks indexing of local/test builds.
SITE_INDEXABLE=false
# Telegram bot token from @BotFather. Keep it server-side and never prefix with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
# Numeric user/group/channel chat ID that will receive website requests.
TELEGRAM_CHAT_ID=

# Optional analytics identifiers. Scripts load only after Analytics consent.
# Paste the public GA4 Measurement ID here (for example, a value beginning with G-).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Paste the numeric Yandex Metrica counter ID here.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
